{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.docs.tsbuildinfo",
    "types": ["vite/client"],
    // dev는 dist가 아닌 소스를 본다 — vite.config.ts의 alias와 짝
    "paths": {
      "@jeon-ji/common-ui": ["../../packages/ui/src/index.ts"],
      "@jeon-ji/common-ui/tokens": ["../../packages/ui/src/tokens/index.ts"],
      "@jeon-ji/common-ui/styles.css": ["../../packages/ui/src/styles/index.css"]
    }
  },
  // paths가 가리키는 ui 소스도 이 프로젝트의 파일 목록에 있어야 한다 (TS6307).
  // 테스트는 vitest 전용 타입 증강(lib 프로젝트 소관)이라 제외한다.
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "plugins",
    "../../packages/ui/src",
    "../../packages/ui/types"
  ],
  "exclude": ["../../packages/ui/src/**/*.test.*"]
}
