{
  "name": "@jeon-ji/common-ui",
  "version": "0.1.0-next.0",
  "type": "module",
  "description": "React 19 디자인 시스템 — CSS 변수 토큰 기반, ESM only",
  "license": "MIT",
  "author": "jeon-ji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeon-ji/common-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://jeon-ji.github.io/common-ui",
  "bugs": "https://github.com/jeon-ji/common-ui/issues",
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-tokens.ts && vite build --config vite.lib.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./tailwind-preset.css": "./dist/tailwind-preset.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
